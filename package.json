{
  "name": "metisai-console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "install-python-deps": "pip install -r requirements.txt",
    "setup-quantum": "npm run install-python-deps && echo 'Quantum dependencies installed successfully'",
    "test-quantum": "python src/lib/quantum/qdllm.py",
    "setup-auth": "echo 'Please configure your Supabase credentials in .env.local' && echo 'See SETUP.md for detailed instructions'",
    "test-auth": "echo 'Testing authentication setup...' && npm run dev",
    "test-platform": "node test-platform.js",
    "test-all": "npm run test-platform && npm run lint",
    "setup-env": "node setup-environment.js",
    "setup-db": "node setup-database.js",
    "validate-env": "node validate-environment.js",
    "test-db": "node test-database.js",
    "setup-production": "npm run setup-env && npm run setup-db && npm run validate-env && npm run test-db",
    "setup-complete": "node setup-complete-environment.js",
    "test-complete": "node test-complete-integration.js",
    "install-deps": "npm install && pip install -r requirements.txt"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "csv-parser": "^3.2.0",
    "ethers": "^6.13.4",
    "next": "15.5.3",
    "python-shell": "^5.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
